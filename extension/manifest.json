{
  "manifest_version": 3,
  "name": "FBIA Cookie Exporter",
  "version": "1.0.0",
  "description": "Export Facebook cookies, fb_dtsg, and lsd for facebook-internal-api tools",
  "permissions": [
    "cookies",
    "downloads",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://*.facebook.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FBIA Cookie Exporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
